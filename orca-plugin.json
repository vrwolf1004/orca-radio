{
  "manifestVersion": 2,
  "id": "radio-for-orca",
  "name": "Radio for Orca",
  "version": "0.7.0",
  "description": "Play internet radio from the Orca sidebar.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "contributes": {
    "panels": [
      {
        "id": "radio",
        "title": "Radio",
        "entry": "panel/index.html"
      }
    ]
  },
  "capabilities": [],
  "main": "src/worker.ts",
  "cover": {
    "path": "docs/store/cover.webp",
    "alt": "Radio for Orca 패널: 황동 라디오 모양의 인터넷 라디오 플레이어"
  },
  "screenshots": [
    {
      "path": "docs/store/screenshot-1.webp",
      "alt": "재생 중인 라디오 패널",
      "caption": "재생 중인 패널"
    },
    {
      "path": "docs/store/screenshot-2.webp",
      "alt": "채널 목록을 펼친 패널",
      "caption": "채널 목록을 펼친 모습"
    },
    {
      "path": "docs/store/screenshot-3.webp",
      "alt": "디자인 A, B, C 비교",
      "caption": "디자인 A·B·C 비교"
    }
  ],
  "repository": "https://github.com/vrwolf1004/orca-radio",
  "author": {
    "name": "vrwolf1004"
  },
  "icon": "docs/store/icon.png"
}
